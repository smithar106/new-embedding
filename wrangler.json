{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "new-embedding",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "EMBEDDING_DB",
			"database_name": "embedding-evolution-db",
			"database_id": "00e28861-4970-4f97-9f13-b29ef2d09cb0",
			"migrations_dir": "migrations"
		}
	],
	"vectorize": [
		{
			"binding": "EMBEDDING_BGE_SMALL",
			"index_name": "embedding-bge-small"
		},
		{
			"binding": "EMBEDDING_BGE_BASE",
			"index_name": "embedding-bge-base"
		},
		{
			"binding": "EMBEDDING_BGE_LARGE",
			"index_name": "embedding-bge-large"
		}
	]
}
